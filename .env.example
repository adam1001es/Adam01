# Auf Vercel: gepoolte Prisma-Accelerate-Verbindung (prisma+postgres://...) - siehe README,
# Abschnitt "Datenbank-Verbindungen (Prisma Accelerate)". NICHT die direkte db.prisma.io-URL
# eintragen, die hat ein viel zu niedriges Verbindungslimit für laufenden App-Traffic.
# Lokal: Verbindung zu einer eigenen Postgres-Instanz eintragen (gleicher Wert wie DIRECT_URL).
DATABASE_URL="postgresql://user:password@localhost:5432/arbeitsblatt_generator"
# Nur für Schema-Änderungen (prisma migrate) - auf Vercel die DIREKTE db.prisma.io-Verbindung
# (die, die man zuerst beim Anlegen der Datenbank bekommt). Lokal: derselbe Wert wie DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/arbeitsblatt_generator"
ANTHROPIC_API_KEY="sk-ant-..."
# Für den Versand der E-Mail-Bestätigung bei der Registrierung (siehe README, Abschnitt
# "E-Mail-Verifizierung"). GMAIL_USER = die Gmail-Adresse, GMAIL_APP_PASSWORT = ein 16-stelliges
# App-Passwort (NICHT das normale Gmail-Passwort) - erzeugt unter myaccount.google.com/apppasswords
# (erfordert 2FA am Google-Konto). Ohne diese beiden Variablen schlägt die Registrierung fehl.
GMAIL_USER="deine-adresse@gmail.com"
GMAIL_APP_PASSWORT="abcdefghijklmnop"
# Optional: Fehlerüberwachung in Produktion (siehe README, Abschnitt "Fehlerüberwachung").
# Kostenloses Konto unter sentry.io, Plattform "Next.js" wählen, DSN aus dem neuen Projekt
# kopieren. Ohne gesetzten Wert läuft die App normal weiter, nur ohne Fehlerberichte.
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
