generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Ein generiertes Arbeitsblatt inkl. Konfiguration, Inhalt und Verifikationsergebnis.
model Worksheet {
  id          String   @id @default(cuid())
  bereich     String // grober Fachbereich, z.B. "Islamischer Religionsunterricht"
  thema       String // konkretes Thema, vom Nutzer vorgegeben
  schulstufe  String
  themenbereich String @default("gemischt") // Iman | Fiqh al-Ibadat | Fiqh al-Muamalat | Islamische Kulturgeschichte
  template    String // "klassisch" | "modern" | "kompakt"
  layoutConfig String  // JSON: Schulname, Schriftgröße, Lösungen separat, Spalten, ...
  contentJson String // JSON: generierter Arbeitsblatt-Inhalt (siehe lib/types.ts)
  verification String  // JSON: Verifikationsergebnis (Status, Hinweise)
  status      String   @default("entwurf") // entwurf | geprueft | verworfen
  favorit     Boolean  @default(false)
  // Vom Admin gesetzt, nachdem eine Meldung (siehe Meldung) geprüft und als berechtigt
  // eingestuft wurde - das Arbeitsblatt bleibt erhalten, zählt aber nicht mehr gegen das
  // monatliche Kontingent der Lehrkraft (siehe getKontingent in lib/quota.ts). Das ist die
  // eigentliche "Erstattung": kein Zahlungsanbieter im Code, aber das verbrauchte Kontingent
  // wird der Lehrkraft zurückgebucht.
  erstattet   Boolean  @default(false)
  // Von der Lehrkraft (nur zahlende Konten, siehe istZahlendesKonto in lib/quota.ts) bewusst
  // für die Community freigegeben - sofort sichtbar für alle anderen zahlenden Konten
  // (app/community), kein Freigabe-Workflow. geteiltAm dient nur der Sortierung "neueste
  // zuerst" und bleibt beim Zurückziehen (geteilt = false) stehen, falls später erneut geteilt
  // wird.
  geteilt     Boolean  @default(false)
  geteiltAm   DateTime?
  // Öffentlicher, nicht angemeldeter Lesezugriff per Link (siehe app/blatt/[token],
  // components/LinkTeilenButton.tsx) - bewusst getrennt von "geteilt" oben (Community-
  // Sichtbarkeit nur unter zahlenden Abo-Konten): für diesen Link braucht es gar kein Konto,
  // gedacht für den Versand z.B. über WhatsApp statt PDF herunterzuladen und woanders wieder
  // hochzuladen. NULL = kein aktiver Link. Beim Widerrufen wird der Token komplett verworfen
  // statt nur ein Flag umzuschalten, damit ein bereits weitergegebener Link danach endgültig
  // ungültig ist - erneutes Aktivieren erzeugt einen frischen Token.
  oeffentlicherLinkToken String? @unique
  // Prüfungs-Modus (siehe app/klassen, lib/generateWorksheet.ts): ein Worksheet mit
  // istPruefung=true ist inhaltlich eine formelle Prüfung (nur prüfungstaugliche Aufgabentypen,
  // Punkte pro Aufgabe statt reiner Übungsaufgaben) statt eines normalen Arbeitsblatts - bleibt
  // bewusst dasselbe Modell statt einer eigenen Tabelle, damit PDF/Word/Kontingent/Community
  // ohne Sonderfälle weiterlaufen. punkteGesamt ist nur bei istPruefung=true gesetzt.
  istPruefung Boolean  @default(false)
  punkteGesamt Int?
  // Woher der Inhalt kommt (siehe lib/types.ts INHALTSQUELLEN/AUSGABEFORMEN, NewWorksheetForm.tsx)
  // - "koran"/"hadith" + ausgabeform "text" bedeutet: reiner, bereits geprüfter Wortlaut ohne
  // KI-generierte Aufgaben (siehe contentJson.koranVerse bzw. contentJson.hadithZitat), kein
  // Claude-Aufruf nötig gewesen. Bewusst als eigene Felder statt nur implizit aus contentJson
  // ablesbar, damit z.B. Übersicht/Auswertung später ohne JSON-Parsing danach filtern können.
  inhaltsquelle String @default("frei")
  ausgabeform String @default("arbeitsblatt")
  // Zählt, wie oft "Aufgabe von KI erstellen" (siehe app/api/worksheet/[id]/aufgabe-generieren,
  // lib/aufgabeErgaenzen.ts) für DIESES Arbeitsblatt bereits genutzt wurde - bewusst pro
  // Arbeitsblatt statt nur global/täglich begrenzt (siehe AUFGABE_ERGAENZEN_PRO_ARBEITSBLATT_MAXIMUM),
  // damit die Funktion nicht zum wiederholten Nachgenerieren vieler Aufgaben auf einem einzigen
  // Arbeitsblatt missbraucht werden kann: 1 reguläre Nutzung, plus 1 weitere, falls die KI dabei
  // inhaltlich danebenlag und die Lehrkraft es nochmal versuchen möchte.
  aufgabeErgaenzenAnzahl Int @default(0)
  createdAt   DateTime @default(now())
  // Optional, damit ältere Arbeitsblätter aus der Zeit vor dem Login-System gültig bleiben -
  // neue Arbeitsblätter bekommen immer einen Besitzer zugewiesen (siehe app/api/generate).
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  meldungen   Meldung[]
  communityFavoriten CommunityFavorit[]
}

// Ein Nutzerkonto (Kolleg:in). Selbst-Registrierung; das Abo-Kontingent (tier) wird nach
// privater Bezahlung von einem Admin manuell zugewiesen - kein Zahlungsanbieter im Code.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Optionaler Anmeldename als schnellere Alternative zur E-Mail beim Login (lib/auth.ts prüft
  // beim Login beides) - selbst gewählt, erst NACH der ersten erfolgreichen Anmeldung setzbar
  // (siehe app/account), daher optional und anfangs leer.
  username     String?  @unique
  passwordHash String
  role         String   @default("user") // "user" | "admin" - der erste registrierte Account wird automatisch Admin
  // War die Registrierung schon vor Einführung der E-Mail-Verifizierung, gilt das Konto per
  // Migration als bereits verifiziert (siehe migration.sql) - nur neue Registrierungen müssen
  // den Link aus der Mail bestätigen, bevor ein Login möglich ist (siehe lib/mailer.ts).
  emailVerifiziert Boolean @default(false)
  verifizierungsToken String? @unique
  verifizierungsTokenAblauf DateTime?
  // Neue, noch nicht bestätigte E-Mail-Adresse (siehe app/api/account/email) - wird erst nach
  // Klick auf den Bestätigungslink (an DIESE Adresse gesendet, siehe app/api/auth/verify) zur
  // aktiven "email". Bis dahin bleibt das Konto mit der alten Adresse voll nutzbar, damit ein
  // Tippfehler oder eine nicht erreichbare neue Adresse niemanden aussperrt. Nutzt denselben
  // verifizierungsToken wie die ursprüngliche Registrierungs-Bestätigung - beide Vorgänge
  // schließen sich zeitlich aus (ein Konto hat nie beide gleichzeitig offen), daher genügt ein
  // gemeinsames Tokenfeld.
  pendingEmail String?
  // Eigenes Tokenfeld statt Wiederverwendung von verifizierungsToken: ein Passwort-Reset kann
  // zeitlich mit einer offenen E-Mail-Änderung zusammenfallen (z.B. Mail-Postfach kompromittiert
  // -> Angreifer:in ändert E-Mail, echte Person will parallel das Passwort zurücksetzen) - beide
  // Vorgänge dürfen sich nicht gegenseitig überschreiben. Kürzere Gültigkeit als die
  // E-Mail-Bestätigung (siehe erzeugePasswortResetToken in lib/auth.ts), da ein gültiger Link
  // hier direkt vollen Kontozugriff verschafft.
  passwortResetToken String? @unique
  passwortResetTokenAblauf DateTime?
  tier         String?  // null (kein Abo) | "pro" (das einzige Abo, 2,50€/18 Arbeitsblätter im Monat). "starter" bleibt als Wert weiterhin gültig (Abwärtskompatibilität für Konten von vor der Umstellung auf ein Ein-Tarif-Modell, siehe lib/quota.ts) - neu zuweisbar ist nur noch "pro".
  // Optionaler Gültigkeitszeitraum für "tier" (z.B. Schuljahr/Semester, nach dem privat bezahlt
  // wird) - beide optional, vom Admin gesetzt. Außerhalb dieses Zeitraums (falls gesetzt) gilt
  // das Konto für die Kontingent-Berechnung automatisch wieder als "kostenlos" (siehe
  // lib/quota.ts), ohne dass ein Admin manuell zurückstellen muss. tier selbst bleibt dabei
  // gespeichert, damit die Zuweisung in der Verwaltung sichtbar bleibt.
  tierGueltigVon DateTime?
  tierGueltigBis DateTime?
  // Profil-Anpassung in app/account (siehe lib/profil.ts für die kuratierte Farbauswahl - bewusst
  // kein Freitext/Upload, kein Emoji, kein Bild) - im Forum und überall sonst öffentlich sichtbar.
  // Standardmäßig werden die Buchstaben live aus dem Benutzernamen berechnet (siehe
  // avatarInitialen in lib/profil.ts, Slack/Google-artig) - Hintergrund- und Buchstabenfarbe sind
  // unabhängig voneinander wählbar und werden gespeichert.
  avatarFarbe  String   @default("#0f766e")
  avatarTextFarbe String @default("#ffffff")
  // Optionale manuelle Überschreibung der Profilbild-Buchstaben (1-3 Buchstaben beliebiger
  // Schrift, z.B. arabisch), unabhängig vom Benutzernamen - z.B. wenn der Benutzername lateinisch
  // bleiben soll (Login-Gewohnheit), das Profilbild selbst aber z.B. arabische Initialen zeigen
  // soll. null = weiterhin automatisch aus dem Benutzernamen berechnet (siehe avatarAnzeige in
  // lib/profil.ts).
  avatarKuerzel String?
  // Selbst gewählter Anwesenheitsstatus (siehe lib/status.ts NUTZER_STATUS) - bewusst rein manuell
  // gewählt, NICHT die tatsächliche Aktivität - als kleiner Farbpunkt am Profilbild sichtbar in
  // den für Nutzer:innen untereinander sichtbaren Bereichen (Forum, Chat, Geteilte
  // Arbeitsblätter, Header). Für die tatsächliche Aktivität (Admin-Kontenübersicht) siehe
  // letzteAktivitaet unten - beide Felder sind bewusst getrennt.
  status String @default("online")
  // Zeitpunkt der letzten authentifizierten Anfrage (siehe getSessionUser in lib/auth.ts,
  // throttled auf max. 1 Schreibzugriff pro Minute) - EINZIG für die Admin-Kontenübersicht
  // gedacht ("wirklich online?", siehe istKuerzlichAktiv in lib/status.ts), NICHT für den
  // selbst gewählten Status oben. null = noch nie einen authentifizierten Request gestellt.
  letzteAktivitaet DateTime?
  // Cluster-IDs aus lib/curriculum.ts SCHULSTUFEN_CLUSTER (z.B. "sek1"), welche Schulstufen die
  // Lehrkraft unterrichtet - freiwillige Selbstauskunft fürs eigene Profil, aktuell nirgendwo
  // sonst ausgewertet.
  unterrichtsStufen String[] @default([])
  // Vom Admin nach Prüfung einer ForumMeldung gesetzt (siehe app/admin/forum-meldungen) - eine
  // gesperrte Lehrkraft nutzt die restliche App normal weiter und kann Themen/Chat im Forum
  // weiterhin LESEN, aber keine neuen Themen/Antworten/Chat-Nachrichten mehr anlegen (siehe
  // Prüfung in app/api/forum/*). Bewusst ein einfaches Boolean statt eines befristeten Zeitraums
  // wie tierGueltigVon/Bis - eine Forum-Sperre ist eine bewusste manuelle Admin-Entscheidung ohne
  // automatisches Ablaufdatum, das Aufheben ebenso.
  forumGesperrt Boolean @default(false)
  createdAt    DateTime @default(now()) // Anker für den rollierenden 30-Tage-Kontingent-Zyklus
  sessions     Session[]
  worksheets   Worksheet[]
  meldungen    Meldung[]
  themaIdeenNutzungen ThemaIdeenUsage[]
  aufgabeErgaenzenNutzungen AufgabeErgaenzenUsage[]
  communityFavoriten CommunityFavorit[]
  usageLogs    UsageLog[]
  klassen      Klasse[]
  forumThreads         ForumThread[]
  forumAntworten       ForumAntwort[]
  forumChatNachrichten ForumChatNachricht[]
  forumMeldungen       ForumMeldung[]
}

// Ein Platzhalter-Eintrag pro GERADE LAUFENDEM Claude-Aufruf (siehe lib/auslastung.ts) - beim
// Start der Generierung angelegt, danach (Erfolg wie Fehler, per finally) wieder gelöscht. Zählt
// wie viele Lehrkräfte aktuell gleichzeitig eine KI-Anfrage laufen haben, damit die App bei
// echtem Andrang einen dezenten Hinweis zeigen kann statt kommentarlos länger zu brauchen. Kein
// Bezug zu einer einzelnen Person/einem Arbeitsblatt - bewusst anonym, nur die Anzahl zählt.
model AktiveGenerierung {
  id        String   @id @default(cuid())
  startedAt DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Zählt die kostenlosen Testversion-Generierungen ohne Konto pro IP-Adresse (siehe lib/trial.ts)
// - zusätzlich zum Cookie-Zähler, damit Cookies löschen/neues Gerät allein nicht reicht, um das
// Kontingent zu umgehen. Weiterhin nach Kalendermonat abgelegt (reine Schreib-Granularität, ein
// Zeile pro IP+Monat), aber beim Lesen ÜBER ALLE Monate hinweg für diese IP aufsummiert
// (lebenslanger Zähler, analog zu KOSTENLOS_TRIAL_ANZAHL_LIMIT selbst - siehe lib/quota.ts). Nur zur
// Missbrauchsprävention gespeichert.
model TrialUsage {
  id        String   @id @default(cuid())
  ip        String
  monat     String // "YYYY-MM"
  anzahl    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([ip, monat])
}

// Ein live per Bild-KI generiertes, sicherheitsgeprüftes Ausmalbild-Motiv (siehe
// lib/imageGen.ts + lib/imageSafety.ts) - referenziert über Aufgabe.bildGeneriertId /
// BildergeschichteSchritt.bildGeneriertId im contentJson eines Worksheet. Wird über
// app/api/generated-image/[id] ausgeliefert.
model GeneratedImage {
  id        String   @id @default(cuid())
  data      Bytes
  createdAt DateTime @default(now())
}

// Meldung einer Lehrkraft zu einem konkreten Arbeitsblatt (z.B. Aufgabe fehlt, Bild
// fehlerhaft, Text falsch). Wird beim Anlegen SOFORT automatisch analysiert (siehe
// lib/meldungFix.ts): Claude prüft, ob das Problem real ist, und schreibt bei Erfolg direkt
// eine korrigierte Version in Worksheet.contentJson zurück - kein manueller Zwischenschritt
// nötig. "status" hält das Ergebnis dieser Analyse fest; "bearbeitet" ist davon unabhängig und
// wird ausschließlich vom Admin gesetzt (z.B. nachdem eine "nicht_behebbar"-Meldung manuell
// nachbearbeitet wurde). Erstattung bleibt separat und manuell (siehe Worksheet.erstattet) -
// eine automatische Korrektur ist kein automatischer Erstattungsgrund.
model Meldung {
  id           String   @id @default(cuid())
  worksheetId  String
  worksheet    Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kategorie    String // "aufgabe_fehlt" | "bild_fehlerhaft" | "text_fehlerhaft" | "sonstiges"
  beschreibung String? // freiwillige, genauere Beschreibung durch die Lehrkraft
  // "offen" (Analyse noch nicht abgeschlossen - sollte nur extrem kurz/im Fehlerfall bestehen
  // bleiben) | "automatisch_behoben" | "nicht_behebbar" (Problem real, KI konnte es nicht sicher
  // beheben) | "kein_fehler_gefunden" (KI hält die Meldung für nicht zutreffend) | "fehler"
  // (Analyse selbst technisch fehlgeschlagen)
  status       String   @default("offen")
  diagnose     String? // kurze, für den Admin verständliche Begründung/Diagnose der KI-Analyse
  bearbeitet   Boolean  @default(false) // vom Admin manuell als gesichtet/erledigt markiert
  createdAt    DateTime @default(now())
}

// Echte Claude-Token-Nutzung pro tatsächlichem API-Aufruf (Erstellung ODER Prüfung - bei einem
// automatischen zweiten Versuch nach "fehler", siehe generateAndVerifyWorksheet, entsprechend
// mehrere Zeilen pro Arbeitsblatt). BEWUSST UNABHÄNGIG vom Worksheet gespeichert: worksheetId ist
// nur eine lose Referenz OHNE Fremdschlüssel-Constraint, kein onDelete: Cascade - wird ein
// Arbeitsblatt später gelöscht (siehe app/api/worksheet/[id], DELETE), bleiben diese Zeilen und
// damit die kumulierte Nutzungs-/Kostenstatistik unverändert bestehen. Die Tokens wurden bereits
// verbraucht und bezahlt, unabhängig davon, ob das Arbeitsblatt danach noch existiert. userId hat
// dieselbe SetNull-Logik wie Worksheet.userId (Konto-Löschung darf die Statistik nicht verfälschen).
model UsageLog {
  id                      String   @id @default(cuid())
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  worksheetId             String? // lose Referenz ohne FK, siehe Kommentar oben
  model                   String // z.B. "claude-opus-5" (siehe lib/anthropic.ts)
  phase                   String // "generierung" | "pruefung" | "zusammenstellung" (Prüfungs-Modus A, siehe lib/pruefungZusammenstellen.ts)
  inputTokens             Int
  outputTokens            Int
  cacheCreationInputTokens Int @default(0)
  cacheReadInputTokens    Int @default(0)
  createdAt               DateTime @default(now())
}

// Zählt, wie oft eine Lehrkraft pro Tag die KI-Themenideen-Funktion nutzt (siehe
// app/api/thema-ideen/route.ts, lib/themaIdeen.ts) - bewusst getrennt vom Arbeitsblatt-
// Kontingent (lib/quota.ts), da dabei kein Arbeitsblatt entsteht, nur eine kurze, günstige
// Ideenliste. Tägliches statt monatliches Limit, weil das ein spontanes Kreativitäts-
// Hilfsmittel ist, nicht die Kernfunktion der App - soll niemanden dauerhaft blockieren.
model ThemaIdeenUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String // "YYYY-MM-DD"
  anzahl    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, tag])
}

// Zählt, wie oft eine Lehrkraft pro Tag eine einzelne Aufgabe per KI zu einem bereits
// bestehenden Arbeitsblatt hinzufügt (siehe app/api/worksheet/[id]/aufgabe-generieren,
// lib/aufgabeErgaenzen.ts) - analog zu ThemaIdeenUsage bewusst ein eigenes, tägliches Limit statt
// des Arbeitsblatt-Kontingents (lib/quota.ts): hier entsteht kein neues Arbeitsblatt, sondern nur
// eine einzelne Ergänzung zu einem bereits (ggf. kostenpflichtig) erstellten.
model AufgabeErgaenzenUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String // "YYYY-MM-DD"
  anzahl    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, tag])
}

// Markiert ein von einer ANDEREN Lehrkraft geteiltes Arbeitsblatt (Worksheet.geteilt) als
// Favorit in der Community-Übersicht (app/community) - bewusst getrennt von Worksheet.favorit
// (das ist der EIGENE Favoriten-Stern der Besitzerin/des Besitzers auf dem eigenen Dashboard),
// da hier mehrere fremde Konten unabhängig voneinander dasselbe Arbeitsblatt favorisieren
// können müssen, ohne sich gegenseitig zu überschreiben.
model CommunityFavorit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  worksheetId String
  worksheet   Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, worksheetId])
}

// Eine Klasse einer Lehrkraft (nur zahlende Konten, siehe istZahlendesKonto in lib/quota.ts) -
// Grundlage für die Wissensstand-/Abdeckungs-Übersicht unter app/klassen. "name" ist frei
// wählbar (z.B. "7A") und enthält bewusst keine Schülerdaten.
model Klasse {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  schulstufe  String?
  createdAt   DateTime    @default(now())
  schueler    Schueler[]
  zuweisungen Zuweisung[]
}

// Ein Schüler/eine Schülerin innerhalb einer Klasse - bewusst NUR als Pseudonym geführt
// ("label", z.B. Default "Schüler 1"), kein Namensfeld. Damit bleibt die Funktion ohne
// personenbezogene Daten Minderjähriger nutzbar; die Lehrkraft kennt die Zuordnung
// Pseudonym -> echte Person nur in ihrem eigenen Kopf/eigenen Unterlagen.
model Schueler {
  id         String     @id @default(cuid())
  klasseId   String
  klasse     Klasse     @relation(fields: [klasseId], references: [id], onDelete: Cascade)
  label      String
  createdAt  DateTime   @default(now())
  ergebnisse Ergebnis[]
}

// Ein Arbeitsblatt oder eine Prüfung, das/die einer Klasse an einem bestimmten Datum gegeben
// wurde - eigenes/Community-Blatt (worksheetId gesetzt) oder ein manuell erfasstes, außerhalb
// von Lernwerk entstandenes Blatt (worksheetId leer, nur die Snapshot-Felder). worksheetId ist
// bewusst eine lose Referenz OHNE Fremdschlüssel-Constraint, exakt wie UsageLog.worksheetId
// (siehe Kommentar dort) - ein späteres Löschen des Quell-Arbeitsblatts darf die
// Zuweisungshistorie und die daraus berechnete Abdeckungs-/Notenübersicht nicht zerstören.
// titel/themenbereich sind deshalb ebenfalls ein Snapshot zum Zeitpunkt der Zuweisung, keine
// Live-Ableitung aus dem (möglicherweise inzwischen gelöschten oder geänderten) Worksheet.
model Zuweisung {
  id            String     @id @default(cuid())
  klasseId      String
  klasse        Klasse     @relation(fields: [klasseId], references: [id], onDelete: Cascade)
  worksheetId   String?
  titel         String
  themenbereich String
  istPruefung   Boolean    @default(false)
  punkteGesamt  Int?
  datum         DateTime
  createdAt     DateTime   @default(now())
  ergebnisse    Ergebnis[]
}

// Das Ergebnis eines Schülers/einer Schülerin zu einer Zuweisung - "prozent" (0-100) ist die
// einzige gespeicherte Kennzahl; eine Schulnote wird daraus erst zur Anzeige abgeleitet (siehe
// prozentZuNote in lib/noten.ts), nicht gespeichert, damit ein späterer Wechsel des
// Notenschlüssels nicht rückwirkend alte Ergebnisse verfälscht.
model Ergebnis {
  id          String    @id @default(cuid())
  zuweisungId String
  zuweisung   Zuweisung @relation(fields: [zuweisungId], references: [id], onDelete: Cascade)
  schuelerId  String
  schueler    Schueler  @relation(fields: [schuelerId], references: [id], onDelete: Cascade)
  prozent     Float?
  notiz       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([zuweisungId, schuelerId])
}

// Admin-only "Wissensbasis" (siehe app/admin/wissensbasis, lib/wissensbasis.ts,
// lib/wissensMining.ts): mit der Zeit wachsender Pool aus geprüften Zitaten (Koran/Hadith) und
// besonders gelungenen Musteraufgaben, gegliedert nach Grundkompetenz. Ziel: Generierung greift
// künftig bevorzugt auf diesen bereits geprüften Bestand zu statt bei jeder Anfrage neu aus dem
// Modellgedächtnis zu schöpfen (siehe generateWorksheet.ts) - islamische Kernwissensinhalte
// ändern sich kaum, ein einmal geprüfter Eintrag bleibt also lange gültig.
model WissensEintrag {
  id                String   @id @default(cuid())
  typ               String   // "zitat" (Koran/Hadith-Angabe) | "musteraufgabe" (Beispielaufgabe)
  themenbereich     String   // ThemenbereichKey (siehe lib/curriculum.ts THEMENBEREICH_KEYS)
  // Nur bei "musteraufgabe" relevant (SchulstufenCluster-Id, z.B. "sek1") - ein Zitat gilt
  // unabhängig von der Schulstufe, eine Musteraufgabe ist meist an ein Sprachniveau gebunden.
  schulstufeCluster String?
  // JSON: bei "zitat" ein Objekt wie Quelle (siehe lib/types.ts: bezeichnung, text, sicherheit)
  // plus optionalem Kontext-Hinweis; bei "musteraufgabe" eine vollständige Aufgabe im
  // Aufgabe-Schema (siehe lib/types.ts), damit sie später 1:1 als Few-Shot-Beispiel taugt.
  inhalt            String
  // Meine Recherche/Begründung für den Admin-Review - IMMER von einer KI verfasst, ersetzt keine
  // fachliche Prüfung durch einen Menschen (siehe status).
  rechercheNotiz    String?
  // Lose Referenzen (wie UsageLog.worksheetId) auf Arbeitsblätter, aus denen dieser Eintrag
  // stammt bzw. in denen dasselbe Zitat/Muster mehrfach auftrat (Konsistenz-Signal) - KEIN
  // Fremdschlüssel, damit ein späteres Löschen des Quell-Arbeitsblatts hier nichts zerstört.
  quellWorksheetIds String[]
  // "entwurf" (von der KI vorgeschlagen, noch ungeprüft) -> "geprueft" (von einem Admin
  // bestätigt, DARF in die Generierung einfließen) | "abgelehnt" (Admin hat widersprochen).
  // WICHTIG: eine KI setzt diesen Status NIE selbst auf "geprueft" - das ist bewusst immer ein
  // menschlicher Schritt, gerade bei religiösen Inhalten.
  status            String   @default("entwurf")
  geprueftAm        DateTime?
  createdAt         DateTime @default(now())
}

// Verhindert ein doppelt erzeugtes Arbeitsblatt, wenn dieselbe Anfrage nach einem
// Verbindungsabbruch (siehe NewWorksheetForm.tsx) erneut abgeschickt wird (siehe
// app/api/generate/route.ts, lib/idempotenz.ts) - kurzlebige Merker-Tabelle, kein dauerhafter
// Datensatz. requestHash identifiziert einen inhaltlich identischen Versuch (gleiche
// Einstellungen); ein anderer Hash (z.B. andere Schulstufe) gilt als eigenständiger, neuer Wunsch.
model GenerierungsAnfrage {
  id          String   @id @default(cuid())
  userId      String
  requestHash String
  status      String // "laeuft" | "fertig" | "fehlgeschlagen"
  worksheetId String? // lose Referenz ohne FK, siehe Kommentar bei UsageLog oben
  createdAt   DateTime @default(now())

  @@index([userId, requestHash])
}

// Ein Thema im Lehrkräfte-Forum (nur zahlende Konten, siehe istZahlendesKonto in lib/quota.ts) -
// Startpunkt eines asynchronen Diskussionsstrangs (siehe ForumAntwort für die Antworten
// darunter). "kategorie" ist bewusst nur ein String mit fester Werteliste in lib/forum.ts
// (FORUM_KATEGORIEN) statt einer eigenen Lookup-Tabelle - analog zu Worksheet.themenbereich:
// eine kleine, vom Admin nicht zu pflegende Werteliste rechtfertigt kein eigenes Modell.
model ForumThread {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  titel     String
  inhalt    String
  kategorie String
  createdAt DateTime       @default(now())
  antworten ForumAntwort[]
}

// Eine Antwort auf ein ForumThread - bewusst eine flache Liste (keine verschachtelten Antworten
// auf Antworten), analog zur einfachen Struktur bestehender Modelle wie Meldung.
model ForumAntwort {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inhalt    String
  createdAt DateTime    @default(now())
}

// Eine Nachricht im "Forum-Chat" (siehe app/forum/chat) - EIN gemeinsamer Raum für alle
// zahlenden Konten (kein Sub-Kanal, keine Direktnachricht), bewusst einfach gehalten passend zur
// zunächst kleinen, überschaubaren Nutzerzahl (Beta unter Kolleg:innen). Wird per Polling
// abgerufen (siehe app/api/forum/chat/route.ts) - keine Realtime-Infrastruktur im Projekt.
model ForumChatNachricht {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inhalt    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Meldung einer Lehrkraft zu einem Forum-Beitrag (Thema, Antwort oder Chat-Nachricht) wegen
// unangemessenen Verhaltens - GRUNDVERSCHIEDEN von Meldung (das ist ein technischer Bug-Report
// zu Arbeitsblatt-Inhalten mit automatischer KI-Korrektur, siehe lib/meldungFix.ts, keine
// Verhaltens-Moderation). zielTyp/zielId sind bewusst eine LOSE Referenz ohne Fremdschlüssel (wie
// UsageLog.worksheetId) statt drei optionaler Relations-Felder: löscht der Admin den gemeldeten
// Beitrag (siehe DELETE-Routen unter app/api/admin/forum/*), soll die Meldung selbst NICHT
// mitgerissen werden (kein Cascade) - der Admin muss auch danach noch sehen, WAS gemeldet und ob
// es bereits bearbeitet wurde. inhaltSnapshot/gemeldeterUserId frieren deshalb Text und
// Autor:in zum Meldezeitpunkt ein (wie Zuweisung.titel/themenbereich einen Worksheet-Snapshot
// einfriert): sonst könnte der Admin nach dem Löschen weder den Text noch die verantwortliche
// Person noch sehen, um sie zu sperren.
model ForumMeldung {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zielTyp          String // "thread" | "antwort" | "chat", siehe FORUM_MELDUNG_ZIEL_TYPEN in lib/forum.ts
  zielId           String // lose Referenz ohne FK, siehe Kommentar oben
  gemeldeterUserId String // lose Referenz ohne FK, Snapshot zum Meldezeitpunkt
  inhaltSnapshot   String
  grund            String?
  bearbeitet       Boolean  @default(false)
  createdAt        DateTime @default(now())
}
