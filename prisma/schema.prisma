generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Ein generiertes Arbeitsblatt inkl. Konfiguration, Inhalt und Verifikationsergebnis.
model Worksheet {
  id          String   @id @default(cuid())
  bereich     String // grober Fachbereich, z.B. "Islamischer Religionsunterricht"
  thema       String // konkretes Thema, vom Nutzer vorgegeben
  schulstufe  String
  themenbereich String @default("gemischt") // Iman | Fiqh al-Ibadat | Fiqh al-Muamalat | Islamische Kulturgeschichte
  template    String // "klassisch" | "modern" | "kompakt"
  layoutConfig String  // JSON: Schulname, Schriftgröße, Lösungen separat, Spalten, ...
  contentJson String // JSON: generierter Arbeitsblatt-Inhalt (siehe lib/types.ts)
  verification String  // JSON: Verifikationsergebnis (Status, Hinweise)
  status      String   @default("entwurf") // entwurf | geprueft | verworfen
  favorit     Boolean  @default(false)
  createdAt   DateTime @default(now())
  // Optional, damit ältere Arbeitsblätter aus der Zeit vor dem Login-System gültig bleiben -
  // neue Arbeitsblätter bekommen immer einen Besitzer zugewiesen (siehe app/api/generate).
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Ein Nutzerkonto (Kolleg:in). Selbst-Registrierung; das Abo-Kontingent (tier) wird nach
// privater Bezahlung von einem Admin manuell zugewiesen - kein Zahlungsanbieter im Code.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("user") // "user" | "admin" - der erste registrierte Account wird automatisch Admin
  tier         String?  // null (kein Abo) | "starter" (30/Monat) | "pro" (80/Monat)
  createdAt    DateTime @default(now()) // Anker für den rollierenden 30-Tage-Kontingent-Zyklus
  sessions     Session[]
  worksheets   Worksheet[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Zählt die kostenlosen Testversion-Generierungen ohne Konto pro IP-Adresse und Kalendermonat
// (siehe lib/trial.ts) - zusätzlich zum Cookie-Zähler, damit Cookies löschen/neues Gerät allein
// nicht reicht, um das Kontingent zu umgehen. Nur zur Missbrauchsprävention gespeichert.
model TrialUsage {
  id        String   @id @default(cuid())
  ip        String
  monat     String // "YYYY-MM"
  anzahl    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([ip, monat])
}

// Ein live per Bild-KI generiertes, sicherheitsgeprüftes Ausmalbild-Motiv (siehe
// lib/imageGen.ts + lib/imageSafety.ts) - referenziert über Aufgabe.bildGeneriertId /
// BildergeschichteSchritt.bildGeneriertId im contentJson eines Worksheet. Wird über
// app/api/generated-image/[id] ausgeliefert.
model GeneratedImage {
  id        String   @id @default(cuid())
  data      Bytes
  createdAt DateTime @default(now())
}
